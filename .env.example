# ==============================================================================
# EHR Intelligence Platform - Environment Configuration Template
# Copy this file to .env before starting the platform: cp .env.example .env
# ==============================================================================

# Application Metadata & Runtime
APP_NAME=EHR Intelligence Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

BACKEND_PORT=8000
FRONTEND_PORT=3001
CHROMA_HOST_PORT=8001

DATABASE_PATH=/app/data/storage/ehr.db

VECTOR_DB_HOST=chromadb
VECTOR_DB_PORT=8000
VECTOR_DB_PATH=/chroma/data

LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
